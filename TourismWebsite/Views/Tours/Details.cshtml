@model TourismWebsite.Models.Tour



@{
    ViewData["Title"] = "Tour Details";
}

<h2 class="mb-4">Tour Details</h2>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-info text-white">
                <h4 class="mb-0">@Model.Title</h4>
            </div>
            <div class="card-body">

                <!-- Category & Price -->
                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Category:</strong> @Model.Category
                    </div>
                    <div class="col-md-6">
                        <strong>Price:</strong> AUD @Model.Price.ToString("0.00")
                    </div>
                </div>

                <!-- Max Group Size & Available Date -->
                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Max Group Size:</strong> @Model.MaxGroupSize
                    </div>
                    <div class="col-md-6">
                        <strong>Available Date:</strong> @Model.AvailableDate.ToString("yyyy-MM-dd")
                    </div>
                </div>

                <!-- Created Date -->
                <div class="mb-3">
                    <strong>Created At:</strong> @Model.CreatedAt?.ToString("yyyy-MM-dd HH:mm")
                </div>

                <!-- Description -->
                <div class="mb-3">
                    <strong>Description:</strong>
                    <p>@Model.Description</p>
                </div>

                <!-- Images -->
                <div class="mb-3">
                    <strong>Images:</strong>
                    <div class="d-flex flex-wrap gap-3 mt-2">
                        @if (!string.IsNullOrEmpty(Model.Image1))
                        {
                            <img src="@Model.Image1" class="img-thumbnail" style="height:150px;" />
                        }
                        @if (!string.IsNullOrEmpty(Model.Image2))
                        {
                            <img src="@Model.Image2" class="img-thumbnail" style="height:150px;" />
                        }
                        @if (!string.IsNullOrEmpty(Model.Image3))
                        {
                            <img src="@Model.Image3" class="img-thumbnail" style="height:150px;" />
                        }
                    </div>
                </div>

                <h4>Feedbacks</h4>
                @if (Model.Feedbacks != null && Model.Feedbacks.Any())
                {
                    foreach (var fb in Model.Feedbacks)
                    {
                        <div class="mb-2">
                            <strong>@fb.User?.UserName </strong>
                            <span>
                                @for (int i = 0; i < fb.Rating; i++)
                                {
                                    <span style="color: gold;">&#9733;</span>
                                }
                                @for (int i = fb.Rating; i < 5; i++)
                                {
                                    <span style="color: #ccc;">&#9733;</span>
                                }
                            </span>
                            <p>@fb.Comment</p>
                        </div>
                    }
                }
                else
                {
                    <p>No feedback yet. Be the first to leave a feedback!</p>
                }





                <!-- Actions -->
            <div class="d-flex justify-content-between align-items-center mt-5 pt-3 border-top">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Back to Tours
                </a>

                <div class="d-flex gap-2">
                    @if (User.Identity.IsAuthenticated)
                    {
                        @if (User.IsInRole("Tourist"))
                        {
                            @* Booking Option for Tourists *@
                            <a asp-controller="TouristBooking" asp-action="Create" asp-route-tourId="@Model.TourId" class="btn btn-success px-4">
                                <i class="bi bi-cart-check"></i> Book This Tour
                            </a>
                        }

                        @if (User.IsInRole("Admin"))
                        {
                            @* Edit Option for Admins *@
                            <a asp-action="Edit" asp-route-id="@Model.TourId" class="btn btn-warning">
                                <i class="bi bi-pencil-square"></i> Edit Tour
                            </a>

                           
                        }
                    }
                    else
                    {
                        @* If guest is not logged in, prompt to login to book *@
                        <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Context.Request.Path" class="btn btn-outline-primary">
                            Login to Book
                        </a>
                    }
                </div>
            </div>

            </div>
        </div>
    </div>
</div>
