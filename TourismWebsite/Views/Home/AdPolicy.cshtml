@{
    ViewData["Title"] = "Ad Policy";
    Layout = "~/Views/Shared/_PageTemplate.cshtml";
}

<!-- HERO -->
<div class="hero"
     style="background: url('https://images.unsplash.com/photo-1557838923-2985c318be48?auto=format&fit=crop&w=1600&q=80')
     center/cover no-repeat; height: 280px; position: relative;">

    <div style="background: rgba(0,0,0,0.55); height: 100%; width: 100%;">
        <div class="position-absolute top-50 start-50 translate-middle text-center">
            <h1 class="text-white fw-bold">@ViewData["Title"]</h1>
            <p class="text-light mt-2">Transparency & trust in advertising</p>
        </div>
    </div>
</div>

<div class="container py-5">

    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <h2 class="card-title text-primary">Advertising Policy</h2>
            <p>All advertisements are reviewed to ensure relevance and quality.</p>
            <p>Ads must comply with applicable laws and should not mislead or deceive users.</p>
            <p>We reserve the right to remove ads that violate our policy or are inappropriate.</p>
        </div>
    </div>

</div>
