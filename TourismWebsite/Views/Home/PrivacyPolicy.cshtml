@{
    ViewData["Title"] = "Privacy Policy";
    Layout = "~/Views/Shared/_PageTemplate.cshtml";
}

<div class="hero" style="background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('https://images.unsplash.com/photo-1563986768609-322da13575f3?auto=format&fit=crop&w=1600&q=80') center/cover; height: 280px; display: flex; align-items: center; justify-content: center;">
    <div class="text-center text-white px-3">
        <h1 class="fw-bold">Your Privacy Rights</h1>
        <p class="lead">Transparency is the foundation of our community.</p>
    </div>
</div>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card border-0 shadow-sm p-4 p-md-5">
                <p class="text-muted">Effective Date: January 1, 2026</p>
                <h3 class="fw-bold text-primary mb-4">1. Information We Collect</h3>
                <p>To provide a seamless booking experience, we collect information that identifies you or can be used to contact you. This includes personal information provided during registration (Name, Email, Birthdate) and transaction information during payment processing.</p>

                <div class="bg-light p-3 rounded mb-4">
                    <h6 class="fw-bold">Automatic Data Collection:</h6>
                    <p class="small mb-0 text-muted">Our servers automatically log your IP address, browser type, and interaction data via cookies to optimize site performance and prevent fraudulent activities.</p>
                </div>

                <h3 class="fw-bold text-primary mb-4">2. How Information is Shared</h3>
                <p>We do not sell your personal data. However, to fulfill your travel requests, we share limited data with:</p>
                <ul>
                    <li><strong>Tour Operators:</strong> Only the details necessary to manage your booking.</li>
                    <li><strong>Payment Processors:</strong> Secured via PCI-compliant encryption.</li>
                    <li><strong>Legal Authorities:</strong> Only when required by law or to protect our users.</li>
                </ul>

                <h3 class="fw-bold text-primary mb-4">3. Data Security & Retention</h3>
                <p>We use Industry-standard SSL/TLS encryption. Personal data is retained only for as long as your account is active or as needed to provide you with services. You may request account deletion at any time by contacting our support team.</p>

                <div class="alert alert-info mt-4">
                    <strong>Third-Party Links:</strong> Our site contains links to external travel resources. We are not responsible for the privacy practices of those external sites.
                </div>
            </div>
        </div>
    </div>
</div>