@{
    ViewData["Title"] = "Terms of Service";
    Layout = "~/Views/Shared/_PageTemplate.cshtml";
}

<div class="hero" style="background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('https://images.unsplash.com/photo-1450101499163-c8848c66ca85?auto=format&fit=crop&w=1600&q=80') center/cover; height: 280px; display: flex; align-items: center; justify-content: center;">
    <div class="text-center text-white px-3">
        <h1 class="fw-bold">Terms of Service</h1>
        <p class="lead">Governing our partnership for your safe travel.</p>
    </div>
</div>

<div class="container py-5">
    <div class="card border-0 shadow-sm p-4 p-md-5">
        <h4 class="fw-bold border-bottom pb-2 mb-4">User Agreement</h4>

        <div class="mb-4">
            <h6 class="fw-bold text-primary">1. Eligibility</h6>
            <p class="text-muted small">You must be at least 18 years of age to book a tour. By using this site, you represent that you have the legal capacity to enter into a binding contract.</p>
        </div>

        <div class="mb-4">
            <h6 class="fw-bold text-primary">2. Booking & Cancellation</h6>
            <p class="text-muted small">All bookings are subject to availability. Cancellations made 30 days prior to travel receive a full refund minus a 10% processing fee. Cancellations made within 7 days of travel are non-refundable unless specified otherwise by the tour provider.</p>
        </div>

        <div class="mb-4">
            <h6 class="fw-bold text-primary">3. Limitation of Liability</h6>
            <p class="text-muted small">TourismWebsite acts as a marketplace. We are not liable for personal injury, property damage, or delays caused by third-party tour operators, weather conditions, or local strikes. We strongly recommend comprehensive travel insurance for all bookings.</p>
        </div>

        <div class="mb-4">
            <h6 class="fw-bold text-primary">4. Code of Conduct</h6>
            <p class="text-muted small">Users agree to respect local laws and customs of the destinations visited. Any user exhibiting behavior that endangers others or disrespects local cultures may have their booking terminated without refund.</p>
        </div>
    </div>
</div>