@{
    ViewData["Title"] = "Our Story";
    Layout = "~/Views/Shared/_PageTemplate.cshtml";
}

<div class="hero" style="background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=1600&q=80') center/cover no-repeat; height: 450px; display: flex; align-items: center; justify-content: center;">
    <div class="text-center text-white px-3">
        <span class="text-uppercase tracking-widest small fw-bold mb-2 d-block" style="letter-spacing: 3px;">Established 2024</span>
        <h1 class="display-3 fw-bold">Redefining Exploration</h1>
        <p class="lead fs-4">A community-driven platform for authentic global discovery.</p>
    </div>
</div>

<div class="container py-5">
    <div class="row align-items-center mb-5 g-5">
        <div class="col-lg-6">
            <span class="text-primary fw-bold text-uppercase small">Since 2024</span>
            <h2 class="display-6 fw-bold mb-4">Travel with Purpose</h2>
            <p>We started with a single realization: the best parts of travel aren't in the brochures—they're in the local markets, the hidden trails, and the stories of the people who live there. Our platform was built to bridge the gap between tourists and local cultures.</p>
            <p>Today, we serve thousands of explorers annually, focusing on high-impact, low-footprint travel. We partner with local guides to ensure that the revenue from your trip stays within the community you visit.</p>

            <div class="row mt-4">
                <div class="col-6">
                    <h3 class="fw-bold text-primary mb-0">500+</h3>
                    <p class="small text-muted">Destinations</p>
                </div>
                <div class="col-6">
                    <h3 class="fw-bold text-primary mb-0">15k+</h3>
                    <p class="small text-muted">Happy Travelers</p>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="position-relative">
                <img src="https://images.unsplash.com/photo-1530789253388-582c481c54b0?auto=format&fit=crop&w=800&q=80" class="img-fluid rounded-4 shadow-lg" alt="Team travel">
                <div class="bg-white p-3 shadow rounded position-absolute bottom-0 start-0 m-4 d-none d-md-block" style="max-width: 200px;">
                    <p class="small mb-0 fw-bold">"The best travel site of 2026"</p>
                    <small class="text-muted">— Global Voyager Magazine</small>
                </div>
            </div>
        </div>
    </div>

    <div class="bg-light p-5 rounded-4 mb-5">
        <div class="text-center mb-5">
            <h2 class="fw-bold">Our Core Pillars</h2>
        </div>
        <div class="row g-4 text-center">
            <div class="col-md-4">
                <i class="bi bi-people display-5 text-primary"></i>
                <h5 class="mt-3">Community First</h5>
                <p class="small text-muted">We prioritize local businesses and sustainable tourism to protect the heartbeat of every destination.</p>
            </div>
            <div class="col-md-4">
                <i class="bi bi-shield-lock display-5 text-primary"></i>
                <h5 class="mt-3">Uncompromising Safety</h5>
                <p class="small text-muted">Every tour and guide goes through a rigorous 20-point vetting process before appearing on our site.</p>
            </div>
            <div class="col-md-4">
                <i class="bi bi-magic display-5 text-primary"></i>
                <h5 class="mt-3">Authenticity</h5>
                <p class="small text-muted">No cookie-cutter experiences. We focus on "off-the-beaten-path" adventures you can't find elsewhere.</p>
            </div>
        </div>
    </div>

    <div class="text-center">
        <h3 class="fw-bold mb-4">The Development Team</h3>
        <div class="row g-4 justify-content-center">
            @{
                var team = new[] {
                    new { ID = "20027319", Name = "Oskar", Role = "Project Lead" },
                    new { ID = "20027505", Name = "Bipin", Role = "Senior Developer" },
                    new { ID = "20030519", Name = "Prabesh", Role = "UI Designer" },
                    new { ID = "20031336", Name = "Susan", Role = "Security Expert" }
                };
            }
            @foreach (var m in team)
            {
                <div class="col-6 col-md-3">
                    <div class="p-3 border rounded shadow-sm hover-up h-100">
                        <div class="bg-primary text-white rounded-circle mx-auto mb-2 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                            <i class="bi bi-person-fill"></i>
                        </div>
                        <h6 class="mb-1">@m.Name</h6>
                        <p class="small text-primary mb-1">@m.Role</p>
                        <code class="xsmall text-muted">#@m.ID</code>
                    </div>
                </div>
            }
        </div>
    </div>
</div>