@model TourismWebsite.Models.TouristBooking

@{
    ViewData["Title"] = "Booking Details";
}

<h2 class="mb-4">Booking Details</h2>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">@Model.Tour?.Title</h4>
            </div>
            <div class="card-body">

                <div class="mb-3">
                    <p><strong>Name:</strong> @Model.TouristName</p>
                    <p><strong>Email:</strong> @Model.TouristEmail</p>
                    <p><strong>Phone:</strong> @Model.TouristPhone</p>
                    <p><strong>No. of People:</strong> @Model.NumPeople</p>
                    <p><strong>Total Price:</strong> @Model.TotalPrice.ToString("C")</p>
                    <p><strong>Booking Date:</strong> @Model.BookingDate.ToString("g")</p>
                    <p>
                        <strong>Status:</strong>
                        @if (Model.Status == "Pending")
                        {
                            <span class="badge bg-warning text-dark">@Model.Status</span>
                        }
                        else if (Model.Status == "Approved")
                        {
                            <span class="badge bg-success">@Model.Status</span>
                        }
                        else if (Model.Status == "Rejected")
                        {
                            <span class="badge bg-danger">@Model.Status</span>
                        }
                    </p>
                </div>

                @* Optional: Add admin note or instructions here *@
                @if (!string.IsNullOrEmpty(Model.Tour?.Description))
                {
                    <div class="mb-3">
                        <strong>Tour Info:</strong>
                        <p>@Model.Tour.Description</p>
                    </div>
                }

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary w-100 me-2">
                        Back to My Bookings
                    </a>

                    @* Optional: cancel button if booking still pending *@
                    @if (Model.Status == "Pending")
                    {
                        <form asp-action="Delete" method="post" class="w-100 ms-2">
                            <input type="hidden" asp-for="BookingId" />
                            <button type="submit" class="btn btn-danger w-100">
                                Cancel Booking
                            </button>
                        </form>
                    }
                </div>

            </div>
        </div>
    </div>
</div>
