@model IEnumerable<TourismWebsite.Models.TouristBooking>

@{
    ViewData["Title"] = "My Bookings";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="bi bi-luggage-fill text-primary me-2"></i>My Bookings</h2>
        <a asp-controller="Tours" asp-action="Index" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-plus-circle"></i> Book New Tour
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 shadow-sm bg-light rounded">
            <i class="bi bi-calendar-x display-1 text-muted"></i>
            <p class="lead mt-3">You haven't booked any tours yet.</p>
            <a asp-controller="Tours" asp-action="Index" class="btn btn-primary">Browse Tours</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var booking in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 tour-card-hover">
                        <div class="position-relative">
                            <img src="@(string.IsNullOrEmpty(booking.Tour?.Image1) ? "https://via.placeholder.com/400x250?text=No+Image" : Url.Content(booking.Tour.Image1))"
                                 class="card-img-top" style="height:200px; object-fit:cover;" />

                            <div class="position-absolute top-0 end-0 m-2">
                                <span class="badge @(booking.Status == "Confirmed" || booking.Status == "Approved" ? "bg-success" : booking.Status == "Pending" ? "bg-warning text-dark" : "bg-danger") shadow">
                                    @booking.Status
                                </span>
                            </div>
                        </div>

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold">@booking.Tour?.Title</h5>

                            <div class="mb-3 small">
                                <div class="text-muted"><i class="bi bi-calendar3 me-2"></i>@booking.BookingDate.ToString("dd MMM yyyy")</div>
                                <div class="text-muted"><i class="bi bi-people me-2"></i>@booking.NumPeople Travelers</div>
                                <div class="text-success fw-bold mt-1"><i class="bi bi-cash-stack me-2"></i>@booking.TotalPrice.ToString("C")</div>
                            </div>

                            <div class="mt-auto">
                                <div class="d-grid gap-2">
                                    <a asp-controller="TouristBooking" asp-action="Details" asp-route-id="@booking.BookingId" class="btn btn-light btn-sm border">
                                        View Details
                                    </a>

                                    @* Feedback Button: Only for Successful Trips *@
                                    @if (booking.Status == "Approved" || booking.Status == "Confirmed")
                                    {
                                        <a asp-controller="Feedbacks" asp-action="Create" asp-route-tourId="@booking.TourId" class="btn btn-success btn-sm">
                                            <i class="bi bi-star-fill me-1"></i> Rate Experience
                                        </a>
                                    }

                                    @* Cancel Button: Only for Pending Trips *@
                                    @if (booking.Status == "Pending")
                                    {
                                        <form asp-action="Delete" method="post" onsubmit="return confirm('Do you want to cancel this booking?');">
                                            <input type="hidden" name="id" value="@booking.BookingId" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm w-100">Cancel Booking</button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .tour-card-hover {
        transition: transform 0.2s;
    }

        .tour-card-hover:hover {
            transform: translateY(-5px);
        }
</style>